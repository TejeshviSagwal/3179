{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Multi-line chart showing visa trends over time.",
  "data": {
    "url": "https://raw.githubusercontent.com/TejeshviSagwal/3179/refs/heads/main/visa_data_cleaned.csv"
  },
  "transform": [
    {
      "fold": [
        "2004-05", "2005-06", "2006-07", "2007-08", "2008-09",
        "2009-10", "2010-11", "2011-12", "2012-13", "2013-14",
        "2014-15", "2015-16", "2016-17", "2017-18", "2018-19",
        "2019-20", "2020-21", "2021-22", "2022-23", "2023-24(g)"
      ],
      "as": ["Year", "Count"]
    },
    {
      "calculate": "parseFloat(datum.Count)",
      "as": "Count"
    }
  ],
  "mark": {
    "type": "line",
    "point": true,
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Financial Year",
      "axis": {"labelAngle": -45}
    },
    "y": {
      "field": "Count",
      "type": "quantitative",
      "title": "Number of People"
    },
    "color": {
      "field": "Visa",
      "type": "nominal",
      "title": "Visa Type",
      "scale": {"scheme": "tableau10"}
    },
    "tooltip": [
      {"field": "Visa", "type": "nominal", "title": "Visa Type"},
      {"field": "Year", "type": "ordinal", "title": "Year"},
      {"field": "Count", "type": "quantitative", "title": "Count"}
    ]
  },
  "title": {
    "text": "Trends in Visa Categories Over Time (2004–2024)",
    "anchor": "start"
  },
  "width": 800,
  "height": 450
}
